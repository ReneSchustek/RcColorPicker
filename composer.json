{
    "name": "ruhrcoder/rc-color-picker",
    "description": "RAL-Farbauswahl und Standard-Farben für Shopware 6 Produkte / RAL color picker and standard colors for Shopware 6 products",
    "type": "shopware-platform-plugin",
    "version": "2.6.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Ruhrcoder"
        }
    ],
    "require": {
        "php": "^8.2",
        "shopware/core": "~6.7.0 || ~6.8.0",
        "shopware/storefront": "~6.7.0 || ~6.8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Ruhrcoder\\RcColorPicker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruhrcoder\\RcColorPicker\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "vendor/bin/phpunit -c phpunit.xml.dist",
        "test:integration": "vendor/bin/phpunit -c phpunit.integration.xml.dist",
        "test:js": "node --test tests/Js/*.test.mjs",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@test:unit",
            "@test:js"
        ]
    },
    "extra": {
        "shopware-plugin-class": "Ruhrcoder\\RcColorPicker\\RcColorPicker",
        "label": {
            "de-DE": "Farbauswahl (RAL & Standard-Farben)",
            "en-GB": "Color Picker (RAL & Standard Colors)"
        },
        "description": {
            "de-DE": "Ermöglicht Kunden die Auswahl von Standard-Farben oder die Eingabe eigener RAL-Farbcodes pro Variante.",
            "en-GB": "Allows customers to select standard colors or enter custom RAL color codes per variant."
        }
    }
}
